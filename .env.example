NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dbname
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=verified-sender@example.com
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OTP_SECRET=replace_with_at_least_32_character_secret
PUBLIC_API_URL=https://ecommerce-lojy.onrender.com
CORS_ORIGINS=http://localhost:5000,https://ecommerce-lojy.onrender.com
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
